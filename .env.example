# Required
DATABASE_URL=postgres://myapp:myapp@localhost:5432/myapp?sslmode=disable
# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me

# Optional
ADDR=:8080
TOKEN_TTL=24h
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Schema changes (go run ./cmd/migrate). Use a direct or session-mode connection.
# Falls back to DATABASE_URL. With Supabase's transaction pooler as DATABASE_URL,
# append ?default_query_exec_mode=simple_protocol to it.
MIGRATE_DATABASE_URL=
